# Combine with your protected runtime environment; never commit real secrets.
COMPOSE_FILE=compose.platform.yaml
MAILBOX_IMAGE_TAG=ubuntu26.04
NODE_IMAGE=
MAILBOX_COMPAT_NETWORK=mailbox_default
# Inspect the current SMTP endpoint before a locked replacement.
MAILBOX_COMPAT_SMTP_IP=172.25.0.2
MAILBOX_API_PORT=20105
MAILBOX_LEGACY_HTTP_PORT=18080
MAILBOX_LEGACY_HTTPS_PORT=18443

# Two workers suit the single-process web backend; auto remains available.
NGINX_WORKER_PROCESSES=2

# V8 old/young generation budgets; native TLS/Argon2/stream buffers are additional.
WEBMAIL_NODE_OPTIONS="--max-old-space-size=512 --max-semi-space-size=16"
