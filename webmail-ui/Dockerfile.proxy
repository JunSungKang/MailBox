FROM nginx:stable-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949

RUN apk upgrade --no-cache \
  && apk add --no-cache 'zlib>=1.4-r0'
COPY nginx.conf.template /etc/nginx/mailbox.conf.template

# Generate only the two operator settings. Preserve nginx request variables.
# All runtime writes stay in the mounted tmpfs, including the generated config.
ENTRYPOINT ["/bin/sh", "-ec"]
CMD ["umask 077; envsubst '${MAIL_WEB_HOSTNAME} ${MAIL_WEB_HTTPS_PORT}' < /etc/nginx/mailbox.conf.template > /tmp/mailbox-nginx.conf; nginx -t -c /tmp/mailbox-nginx.conf; exec nginx -c /tmp/mailbox-nginx.conf -g 'daemon off;'"]
