compatibility_level = 3.10

myhostname = mail.ds-mail.p-e.kr
myorigin = $mydomain
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8

smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
maillog_file = /var/log/postfix.log

smtpd_tls_security_level = may
smtpd_tls_cert_file = /etc/mailbox/tls/fullchain.pem
smtpd_tls_key_file = /etc/mailbox/tls/privkey.pem
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_auth_only = yes
smtp_tls_security_level = verify
smtp_tls_verify_cert_match = hostname
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

virtual_mailbox_domains = ds-mail.p-e.kr post.ds-mail.p-e.kr
virtual_mailbox_base = /var/mail/vhosts
virtual_mailbox_maps = lmdb:/var/lib/mailbox-maps/virtual-mailbox-accounts
virtual_minimum_uid = 5000
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_transport = virtual

smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unauth_destination
smtpd_sasl_auth_enable = no
smtpd_sasl_type = dovecot
smtpd_sasl_path = /run/smtp-auth/auth
disable_vrfy_command = yes

local_recipient_maps =
relayhost =
mailbox_size_limit = 0
virtual_mailbox_limit = 0
message_size_limit = 52428800
recipient_delimiter = +
