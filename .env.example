MAIL_HOSTNAME=mail.ds-mail.p-e.kr
MAIL_DOMAINS=ds-mail.p-e.kr post.ds-mail.p-e.kr
MAILBOX_ACCOUNT_VOLUME=mailbox-account-store
MAIL_FROM=mailbox@ds-mail.p-e.kr
MAIL_DEFAULT_DOMAIN=ds-mail.p-e.kr
WEBMAIL_SESSION_SECRET=replace-with-at-least-32-random-characters
WEBMAIL_SIGNUP_TOKEN=replace-with-an-administrator-signup-code
WEBMAIL_COOKIE_SECURE=false

MAIL_TLS_DIR=./tls
MAIL_WEB_HOSTNAME=mail.ds-mail.p-e.kr

SMTP_PORT=25
IMAP_PORT=143
MAIL_WEB_PORT=18080
MAIL_WEB_HTTPS_PORT=18443

MAIL_NETWORK_SUBNET=172.25.0.0/16
MYNETWORKS=127.0.0.0/8 172.25.0.0/16

MAILBOX_VOLUME=mailbox-store
SMTP_QUEUE_VOLUME=smtp-queue-store
WEBMAIL_DATA_VOLUME=webmail-data-store

MAIL_LOG_DIR=./logs
MAIL_LOG_MAX_SIZE=10m
MAIL_LOG_MAX_FILE=5
